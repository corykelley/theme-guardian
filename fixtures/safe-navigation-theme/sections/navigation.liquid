{% comment %} Safe nested loop - navigation menu {% endcomment %}

{% for block in section.blocks %}
  <div class="menu-block">
    <h3>{{ block.settings.title }}</h3>
    {% for link in block.settings.menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
  </div>
{% endfor %}

{% schema %}
{
  "name": "Navigation",
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
